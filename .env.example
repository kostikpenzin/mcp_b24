# Bitrix24 MCP server — example environment configuration.
# Copy to .env and fill in. NEVER commit .env with real secrets.

# === AUTH (choose one) ===
# Webhook (simplest): an incoming webhook from your portal.
BX24_MODE=webhook
BX24_WEBHOOK_URL=https://acme.bitrix24.ru/rest/1/abc123def/

# OAuth application (portal-wide, auto-refresh):
# BX24_MODE=oauth
# BX24_DOMAIN=acme.bitrix24.ru
# BX24_CLIENT_ID=app.abc123
# BX24_CLIENT_SECRET=******
# BX24_REFRESH_TOKEN=******
# BX24_ACCESS_TOKEN=                      # optional; obtained from refresh if unset
# BX24_OAUTH_SERVER=https://oauth.bitrix.info   # default; override for on-premise

# === BEHAVIOR ===
BX24_CONFIRM_DESTRUCTIVE=true            # require confirm:true for destructive actions
BX24_AUTO_PAGINATE=false                 # auto-collect list pages up to BX24_MAX_ROWS
BX24_MAX_ROWS=5000
BX24_RATE_LIMIT_RPS=2                    # ≤2 non-Enterprise, ≤5 Enterprise
BX24_RATE_LIMIT_BURST=50
BX24_DEFAULT_LANG=ru                     # ru | en
BX24_LOG_LEVEL=info                      # silent | error | warn | info | debug
BX24_AUDIT_LOG=./audit.log               # JSONL audit of destructive + auth events (omit to disable)

# === TRANSPORT ===
BX24_TRANSPORT=stdio                     # stdio | http
BX24_HTTP_HOST=127.0.0.1
BX24_HTTP_PORT=3000
BX24_HTTP_PATH=/mcp